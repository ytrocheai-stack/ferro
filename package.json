{
  "name": "nextrep",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild.mjs && node scripts/check-public-bundle.mjs",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-dataset.mjs && node scripts/fetch-real-data.mjs",
    "fetch-real-data": "node scripts/fetch-real-data.mjs",
    "corpus:prepare": "node --experimental-strip-types scripts/corpus-prepare.ts",
    "provider:doctor": "node --experimental-strip-types scripts/provider-doctor.ts",
    "corpus:validate": "node scripts/corpus-cli.mjs .cache/corpus/hevy/manifest.json validate",
    "corpus:report": "node scripts/corpus-cli.mjs .cache/corpus/hevy/manifest.json report",
    "corpus:import-plan": "node scripts/corpus-cli.mjs .cache/corpus/hevy/manifest.json import",
    "corpus:evaluate": "node scripts/corpus-cli.mjs .cache/corpus/hevy/manifest.json evaluate --reference worker/corpus/evaluation-queries.json",
    "corpus:embed": "node --experimental-strip-types scripts/corpus-embed.ts",
    "corpus:upload": "node --experimental-strip-types scripts/corpus-upload.ts",
    "corpus:verify-remote": "node --experimental-strip-types scripts/corpus-verify-remote.ts",
    "corpus:review": "node scripts/corpus-review.mjs",
    "corpus:inventory": "node scripts/corpus-inventory.mjs",
    "corpus:benchmark": "node --experimental-strip-types scripts/corpus-benchmark.ts",
    "corpus:status": "node scripts/corpus-status.mjs",
    "corpus:release": "node scripts/corpus-release.mjs",
  "coach:smoke": "node scripts/coach-smoke.mjs",
  "coach:agent-smoke": "node scripts/coach-agent-smoke.mjs",
    "agent:lab": "node --experimental-strip-types packages/agent-lab/src/cli.ts run",
    "agent:evaluate": "node --experimental-strip-types packages/agent-lab/src/cli.ts evaluate",
    "agent:rag": "node --experimental-strip-types packages/agent-lab/src/cli.ts rag",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "vitest run && node --test scripts/corpus-gates.node.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:coach": "playwright test --config=playwright.coach.config.ts",
    "test:worker": "npm --prefix worker run test",
    "deploy:production": "npm --prefix worker run deploy:production",
    "deploy:worker": "npm --prefix worker run deploy",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run typecheck:worker && npm run test && npm run build"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.6",
    "@clerk/react": "^6.14.7",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.11",
    "recharts": "^2.15.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6",
    "wrangler": "4.30.0"
  }
}
